const toggle=document.querySelector('.menu'),nav=document.querySelector('#nav');toggle.addEventListener('click',()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Menü schliessen':'Menü öffnen');toggle.textContent=open?'×':'☰'});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Menü öffnen');toggle.textContent='☰'}));const spaces={restaurant:['Klein, fein und voller Leben.','Rund 30 Plätze für gemütliche Abende, gute Gespräche und die Vielfalt der spanischen Küche.'],terrasse:['Feriengefühl unter Platanen.','Unsere lauschige Terrasse bietet bei schönem Wetter rund 50 Gästen Platz – mit Schatten unter den Platanen und einer wunderbaren Aussicht.'],saal:['Platz für besondere Momente.','Ob Bankett, Hochzeit oder Firmenfeier: Im grossen Saal feiern Sie mit bis zu 70 Personen. Kontaktieren Sie uns für Ihren Anlass.'],keller:['Ein besonderer Ort im kleinen Kreis.','Unser stimmungsvoller Weinkeller ist der passende Rahmen für Apéros und gemütliche Essen mit bis zu ca. 10 Personen.']};document.querySelectorAll('.space').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.space').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});b.classList.add('active');b.setAttribute('aria-pressed','true');document.querySelector('#space-title').textContent=spaces[b.dataset.space][0];document.querySelector('#space-text').textContent=spaces[b.dataset.space][1]}));
const dialog=document.querySelector('#reservation'),form=document.querySelector('#reservation-form'),dateInput=document.querySelector('#reservation-date'),timeInput=document.querySelector('#reservation-time'),statusText=document.querySelector('#reservation-status');let month=bookingRules.zurichNow().date.slice(0,7),lastTrigger;
function renderCalendar(){const [y,m]=month.split('-').map(Number),first=new Date(Date.UTC(y,m-1,1)),count=new Date(Date.UTC(y,m,0)).getUTCDate(),grid=document.querySelector('#calendar-days');document.querySelector('#calendar-month').textContent=new Intl.DateTimeFormat('de-CH',{month:'long',year:'numeric',timeZone:'UTC'}).format(first);grid.replaceChildren();document.querySelector('#prev-month').disabled=month<=bookingRules.zurichNow().date.slice(0,7);for(let i=0;i<(first.getUTCDay()+6)%7;i++)grid.append(document.createElement('span'));for(let n=1;n<=count;n++){const date=`${month}-${String(n).padStart(2,'0')}`,b=document.createElement('button');b.type='button';b.textContent=n;b.disabled=!bookingRules.slots(date).length;b.className=dateInput.value===date?'selected':'';b.setAttribute('aria-pressed',String(dateInput.value===date));b.setAttribute('aria-label',new Intl.DateTimeFormat('de-CH',{dateStyle:'full',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'))+(b.disabled?' – nicht verfügbar':''));b.addEventListener('click',()=>{dateInput.value=date;refreshTimes();renderCalendar();statusText.textContent='';timeInput.focus()});grid.append(b)}}
function refreshTimes(){const previous=timeInput.value,slots=bookingRules.slots(dateInput.value);timeInput.replaceChildren(new Option(slots.length?'Uhrzeit wählen':'Keine Uhrzeiten verfügbar',''));slots.forEach(t=>timeInput.add(new Option(t,t)));timeInput.disabled=!slots.length;if(slots.includes(previous))timeInput.value=previous;}
function moveMonth(delta){const [y,m]=month.split('-').map(Number);month=new Date(Date.UTC(y,m-1+delta,1)).toISOString().slice(0,7);renderCalendar()}
document.querySelector('#prev-month').onclick=()=>moveMonth(-1);document.querySelector('#next-month').onclick=()=>moveMonth(1);document.querySelectorAll('[data-reserve]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();lastTrigger=a;renderCalendar();refreshTimes();dialog.showModal();document.body.classList.add('booking-open')}));document.querySelector('.close-dialog').onclick=()=>dialog.close();dialog.addEventListener('close',()=>{document.body.classList.remove('booking-open');lastTrigger?.focus()});dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});
form.addEventListener('submit',e=>{e.preventDefault();if(!bookingRules.slots(dateInput.value).includes(timeInput.value)){statusText.textContent='Bitte wählen Sie ein verfügbares Datum und eine gültige Uhrzeit.';refreshTimes();return}if(!form.reportValidity())return;const d=new FormData(form),body=`Guten Tag La Fiesta,\n\nich möchte einen Tisch anfragen:\n\nDatum: ${d.get('date')}\nUhrzeit: ${d.get('time')} (Schweizer Ortszeit)\nPersonen: ${d.get('guests')}\nName: ${d.get('name')}\nTelefon: ${d.get('phone')}\nE-Mail: ${d.get('email')}\nKommentare: ${d.get('comments')||'–'}\n\nBitte bestätigen Sie mir die Reservation. Vielen Dank!`;window.location.href='mailto:lafiesta@loohof.ch?subject='+encodeURIComponent('Tischanfrage · '+d.get('date')+' · '+d.get('time'))+'&body='+encodeURIComponent(body);statusText.textContent='Ihre Anfrage wurde zum Öffnen an Ihr E-Mail-Programm übergeben, noch nicht versendet. Bitte senden Sie die E-Mail dort ab. Falls sich kein Programm öffnet, rufen Sie uns unter 062 797 12 18 an.'});
